{
  "name": "local-ai-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Локальный AI-клиент для Linux",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:main": "tsc -p tsconfig.electron.json --watch",
    "dev:electron": "wait-on tcp:5173 dist/main/index.js && cross-env LOCAL_AI_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist/main/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "test:attachments": "npm run build && node dist/main/services/attachment-pipeline.test.js",
    "start": "electron ."
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@keep-lts/xlsx": "^0.18.6",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289",
    "playwright-core": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^39.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  }
}
